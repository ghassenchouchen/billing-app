pipeline {
    agent { label 'built-in' }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '5'))
    }

    environment {
        AWS_CREDENTIALS  = credentials('aws-credentials-2')
        AWS_REGION       = 'us-east-1'
        AWS_ACCOUNT_ID   = credentials('aws-account-id-2')
        ECR_REGISTRY     = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        CONFIG_REPO_URL  = 'https://github.com/ghassenchouchen/billing-app-config.git'
    }

    stages {

        stage('Detect Changes') {
            steps {
                script {
                    def base = env.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: 'HEAD~1'
                    def changedFiles = sh(
                        script: "git diff --name-only ${base} ${GIT_COMMIT}",
                        returnStdout: true
                    ).trim()

                    def services = [
                        'api-gateway', 'authentication-service', 'billing-service',
                        'boutique-service', 'catalog-service', 'customer-service',
                        'subscription-service', 'usage-service'
                    ]

                    env.CHANGED_SERVICES = services.findAll { svc ->
                        changedFiles.contains("spring-backend/${svc}/")
                    }.join(',')

                    echo "Changed services: ${env.CHANGED_SERVICES ?: 'none — skipping build'}"
                }
            }
        }

        stage('Build & Test') {
            when { expression { env.CHANGED_SERVICES } }
            steps {
                script {
                    env.CHANGED_SERVICES.split(',').each { svc ->
                        dir("spring-backend/${svc}") {
                            sh 'mvn -B -ntp clean verify'
                        }
                    }
                }
            }
            post {
                always {
                    script {
                        if (env.CHANGED_SERVICES) {
                            env.CHANGED_SERVICES.split(',').each { svc ->
                                def reportDir = "spring-backend/${svc}/target/surefire-reports"
                                if (fileExists(reportDir)) {
                                    junit "${reportDir}/*.xml"
                                }
                            }
                        }
                    }
                }
            }
        }

        stage('Code Quality') {
            when { expression { env.CHANGED_SERVICES } }
            steps {
                withSonarQubeEnv('SonarQube') {
                    script {
                        env.CHANGED_SERVICES.split(',').each { svc ->
                            dir("spring-backend/${svc}") {
                                sh 'mvn -B -ntp sonar:sonar'
                            }
                        }
                    }
                }
            }
        }

        stage('Docker Build') {
            when { expression { env.CHANGED_SERVICES } }
            steps {
                script {
                    env.CHANGED_SERVICES.split(',').each { svc ->
                        def image = "${env.ECR_REGISTRY}/billing/${svc}"
                        dir("spring-backend/${svc}") {
                            sh "docker build -t ${image}:${BUILD_NUMBER} -t ${image}:latest ."
                        }
                    }
                }
            }
        }

        stage('Trivy Security Scan') {
            when { expression { env.CHANGED_SERVICES } }
            steps {
                script {
                    env.CHANGED_SERVICES.split(',').each { svc ->
                        def image = "${env.ECR_REGISTRY}/billing/${svc}:${BUILD_NUMBER}"
                        echo "Scanning ${image} for vulnerabilities..."
                        sh "trivy image --severity CRITICAL --exit-code 1 --no-progress ${image}"
                    }
                }
            }
        }

        stage('Push to ECR') {
            when { expression { env.CHANGED_SERVICES } }
            steps {
                script {
                    docker.withRegistry("https://${ECR_REGISTRY}", "ecr:${AWS_REGION}:aws-credentials-2") {
                        env.CHANGED_SERVICES.split(',').each { svc ->
                            def image = "${env.ECR_REGISTRY}/billing/${svc}"
                            sh "docker push ${image}:${BUILD_NUMBER}"
                            sh "docker push ${image}:latest"
                        }
                    }
                }
            }
        }

        stage('Update Config Repo') {
            when { expression { env.CHANGED_SERVICES } }
            steps {
                script {
                    withCredentials([string(credentialsId: 'github-token', variable: 'GH_TOKEN')]) {
                        sh "rm -rf billing-app-config"
                        sh "git clone https://${GH_TOKEN}@github.com/ghassenchouchen/billing-app-config.git"

                        dir('billing-app-config') {
                            env.CHANGED_SERVICES.split(',').each { svc ->
                                def valuesFile = "charts/backend/services/${svc}/values.yaml"
                                if (fileExists(valuesFile)) {
                                    sh """
                                        sed -i 's|tag:.*|tag: "${BUILD_NUMBER}"|' ${valuesFile}
                                    """
                                    echo "Updated ${svc} image tag to ${BUILD_NUMBER}"
                                } else {
                                    echo "WARNING: ${valuesFile} not found - skipping ${svc}"
                                }
                            }

                            sh """
                                git config user.email 'jenkins@billing-app.ci'
                                git config user.name 'Jenkins CI'
                                git add -A
                                git diff --cached --quiet || git commit -m "ci: update image tags to build ${BUILD_NUMBER}"
                                git push origin main || echo "No changes to push
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                if (env.CHANGED_SERVICES) {
                    env.CHANGED_SERVICES.split(',').each { svc ->
                        sh "docker rmi ${ECR_REGISTRY}/billing/${svc}:${BUILD_NUMBER} ${ECR_REGISTRY}/billing/${svc}:latest || true"
                    }
                }
            }
            sh 'docker image prune -f || true'
            sh 'docker logout || true'
            sh 'rm -rf billing-app-config || true'
        }
    }
}
