pipeline {
    agent { label 'built-in' }

    options {
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '5'))
    }

    environment {
        AWS_CREDENTIALS  = credentials('aws-credentials-2')
        AWS_REGION       = 'us-east-1'
        AWS_ACCOUNT_ID   = credentials('aws-account-id-2')
        ECR_REGISTRY     = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        DOCKER_IMAGE     = "${ECR_REGISTRY}/billing/frontend"
    }

    stages {
        stage('Detect Changes') {
            steps {
                script {
                    def base = env.GIT_PREVIOUS_SUCCESSFUL_COMMIT ?: 'HEAD~1'
                    def changedFiles = sh(
                        script: "git diff --name-only ${base} ${GIT_COMMIT}",
                        returnStdout: true
                    ).trim()

                    env.FRONTEND_CHANGED = changedFiles.contains('billing-app-frontend/') ? 'true' : ''
                    echo "Frontend changes: ${env.FRONTEND_CHANGED ? 'yes' : 'none — skipping build'}"
                }
            }
        }

        stage('Build') {
            when { expression { env.FRONTEND_CHANGED } }
            steps {
                dir('billing-app-frontend') {
                    sh 'npm ci'
                    sh 'npm run build -- --configuration production'
                }
            }
        }

        stage('Code Quality') {
            when { expression { env.FRONTEND_CHANGED } }
            steps {
                withSonarQubeEnv('SonarCloud') {
                    script {
                        def scanner = tool name: 'sonarqube-scanner', type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                        dir('billing-app-frontend') {
                            sh "${scanner}/bin/sonar-scanner -Dsonar.organization=ghassenchouchen -Dsonar.projectKey=billing-app_frontend"
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            when { expression { env.FRONTEND_CHANGED } }
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Docker Build & Push to ECR') {
            when { expression { env.FRONTEND_CHANGED } }
            steps {
                script {
                    docker.withRegistry("https://${ECR_REGISTRY}", "ecr:${AWS_REGION}:aws-credentials-2") {
                        dir('billing-app-frontend') {
                            sh 'docker build -t $DOCKER_IMAGE:$BUILD_NUMBER -t $DOCKER_IMAGE:latest .'
                            sh 'docker push $DOCKER_IMAGE:$BUILD_NUMBER'
                            sh 'docker push $DOCKER_IMAGE:latest'
                        }
                    }
                }
            }
        }

        stage('Update Config Repo') {
            when { expression { env.FRONTEND_CHANGED } }
            steps {
                script {
                    withCredentials([string(credentialsId: 'github-token', variable: 'GH_TOKEN')]) {
                        sh 'rm -rf billing-app-config'
                        sh 'git clone https://$GH_TOKEN@github.com/ghassenchouchen/billing-app-config.git'

                        dir('billing-app-config') {
                            def valuesFile = 'charts/frontend/values.yaml'
                            if (fileExists(valuesFile)) {
                                sh "sed -i 's|tag:.*|tag: \"${BUILD_NUMBER}\"|' ${valuesFile}"
                                echo "Updated frontend image tag to ${BUILD_NUMBER}"
                            } else {
                                echo "WARNING: ${valuesFile} not found - skipping"
                            }

                            sh """
                                git config user.email 'jenkins@billing-app.ci'
                                git config user.name 'Jenkins CI'
                                git add -A
                                git diff --cached --quiet || git commit -m "ci: update frontend image tag to build ${BUILD_NUMBER}"
                                git push origin main || echo "No changes to push"
                            """
                        }
                    }
                }
            }
        }
    }

    post {
        always {
            sh 'docker rmi $DOCKER_IMAGE:$BUILD_NUMBER $DOCKER_IMAGE:latest || true'
            sh 'docker image prune -f || true'
            sh 'docker logout || true'
            sh 'rm -rf billing-app-config || true'
        }
    }
}
