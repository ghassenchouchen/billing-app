pipeline {
    agent { label 'built-in' }


    options {
        buildDiscarder(logRotator(numToKeepStr: '20', artifactNumToKeepStr: '5'))
    }

    environment {
        DOCKER_HUB_CREDENTIALS = credentials('dockerhub-credentials')
        DOCKER_IMAGE           = 'ghassenchouchen/billing-frontend'
    }

    stages {
        stage('Install') {
            steps {
                dir('billing-app-frontend') {
                    sh 'npm ci'
                }
            }
        }

        stage('Build') {
            steps {
                dir('billing-app-frontend') {
                    sh 'npm run build -- --configuration production'
                }
            }
        }
    /*
        stage('Test & Coverage') {
            steps {
                dir('billing-app-frontend') {
                    sh 'npm run test -- --no-watch --no-progress --code-coverage --browsers=ChromeHeadless'
                }
            }
        }
        */

        stage('Code Quality') {
            steps {
                withSonarQubeEnv('SonarQube') {
                    script {
                        def scanner = tool name: 'sonarqube-scanner', type: 'hudson.plugins.sonar.SonarRunnerInstallation'
                        dir('billing-app-frontend') {
                            sh "${scanner}/bin/sonar-scanner"
                        }
                    }
                }
            }
        }

        stage('Docker Build, Scan & Push') {
            steps {
                sh 'echo $DOCKER_HUB_CREDENTIALS_PSW | docker login -u $DOCKER_HUB_CREDENTIALS_USR --password-stdin'
                dir('billing-app-frontend') {
                    sh 'docker build -t ${DOCKER_IMAGE}:${BUILD_NUMBER} -t ${DOCKER_IMAGE}:latest .'
                    // Scan the newly built image with Trivy (fail build on CRITICAL vulnerabilities)
                    sh 'trivy image --severity CRITICAL --exit-code 1 --no-progress ${DOCKER_IMAGE}:${BUILD_NUMBER}'
                    sh 'docker push ${DOCKER_IMAGE}:${BUILD_NUMBER}'
                    sh 'docker push ${DOCKER_IMAGE}:latest'
                }
            }
        }
    }

    post {
        always {
            sh 'docker rmi ${DOCKER_IMAGE}:${BUILD_NUMBER} ${DOCKER_IMAGE}:latest || true'
            sh 'docker image prune -f || true'
            sh 'docker logout || true'
        }
    }
}
